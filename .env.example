ODOO_IMAGE=odoo:19
PG_IMAGE=postgres:18
POSTGRES_USER=odoo19
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
ODOO_ADMIN_PASSWORD=
ODOO_HTTP_PORT=10019
ODOO_CHAT_PORT=20019
ODOO_PROXY_MODE=False
ODOO_NETWORK=odoo19_internal
ODOO_CONTAINER_NAME=odoo19
ODOO_DB_CONTAINER_NAME=odoo19-db
ODOO_DATA_VOLUME=odoo19_data
ODOO_ROUTER_NAME=odoo19

# Used only with docker-compose.traefik.yml
ODOO_DOMAIN=odoo.example.com
DOCKER_PROXY_NETWORK=proxy
